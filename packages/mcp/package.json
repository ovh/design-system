{
  "name": "@ovhcloud/ods-mcp",
  "version": "19.7.3",
  "description": "MCP server exposing the OVHcloud Design System documentation to AI assistants",
  "author": "OVH SAS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovh/design-system.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "ods-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "content",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:prod": "pnpm run clean && tsc -p tsconfig.json && node scripts/copy-content.mjs",
    "clean": "rimraf dist content",
    "start": "node dist/index.js",
    "test:spec": "pnpm run build:prod && node tests/run.mjs",
    "test:spec:ci": "pnpm run test:spec"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ovhcloud/ods-react": "workspace:*",
    "@ovhcloud/ods-recipes": "workspace:*",
    "@ovhcloud/ods-themes": "workspace:*",
    "@types/node": "24.13.2",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
