{
  "name": "@ovhcloud/ods-migrate",
  "version": "20.0.0",
  "description": "Migration tooling from ODS v19 to v20: codemod, ESLint rule and migration guide, from one mapping",
  "author": "OVH SAS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovh/design-system.git",
    "directory": "packages/ods-migrate"
  },
  "type": "module",
  "bin": {
    "ods-migrate": "./src/cli.mjs"
  },
  "exports": {
    "./eslint-plugin": "./src/eslint-plugin.mjs",
    "./mapping": "./mappings/v19-to-v20.json",
    "./tokens-mapping": "./mappings/tokens-v19-to-v20.json",
    "./stylelint-plugin": "./src/stylelint-plugin.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "mappings",
    "configurator/choices.json",
    "configurator/index.html",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "guide": "node src/guide.mjs",
    "test": "pnpm run test:spec",
    "test:spec": "node --test tests/*.test.mjs",
    "test:spec:ci": "pnpm run test:spec",
    "build:tokens": "node scripts/build-token-mapping.mjs",
    "build:configurator": "node configurator/build.mjs",
    "coverage": "node scripts/coverage.mjs",
    "acceptance": "bash scripts/acceptance/acceptance.sh",
    "coverage:check": "node scripts/coverage-check.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "0.36.3",
    "diff": "4.0.4",
    "postcss": "8.5.26",
    "postcss-scss": "4.0.9",
    "postcss-value-parser": "4.2.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "stylelint": ">=16.17"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.62.0",
    "eslint": "10.5.0",
    "sass": "1.103.1",
    "stylelint": "17.14.1",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  }
}
