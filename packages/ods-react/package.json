{
  "name": "@ovhcloud/ods-react",
  "version": "19.7.3",
  "description": "ODS React Components",
  "author": "OVH SAS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovh/design-system.git",
    "directory": "packages/ods-react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/src/components/*/src/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./normalize-css": {
      "default": "./src/style/normalize.css"
    },
    "./style": {
      "default": "./src/style/index.scss"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:prod": "npm run clean && tsc -b && vite build && npm run copy:llms",
    "clean": "rimraf dist",
    "copy:llms": "node scripts/copy-llms.js",
    "doc": "rimraf documentation && typedoc",
    "lint:scss": "stylelint 'src/style/*.scss'",
    "lint:ts": "eslint 'src/{helpers,hooks,style,utils}/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "test:spec": "jest --passWithNoTests",
    "test:spec:ci": "npm run test:spec"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.0",
    "@tanstack/react-table": "8.21.3",
    "@zag-js/i18n-utils": "1.24.2",
    "classnames": "2.5.1",
    "libphonenumber-js": "1.13.11",
    "react-hot-toast": "2.6.0",
    "react-markdown": "10.1.0",
    "react-shiki": "0.10.1",
    "react-swipeable": "7.0.2",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@shikijs/langs": "4.3.0",
    "@shikijs/themes": "4.3.0",
    "@shikijs/types": "4.3.0",
    "@storybook/react": "8.6.12",
    "@storybook/react-vite": "8.6.12",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "cssjson": "2.1.3",
    "glob": "13.0.6",
    "jest": "30.4.2",
    "jest-puppeteer": "10.0.1",
    "jest-transform-stub": "2.0.0",
    "puppeteer": "25.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.103.1",
    "start-server-and-test": "3.0.12",
    "storybook": "8.6.12",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-lib-inject-css": "2.2.2"
  }
}
