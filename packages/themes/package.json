{
  "name": "@ovhcloud/ods-themes",
  "version": "20.0.0",
  "description": "All ODS Themes",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovh/design-system.git",
    "directory": "packages/themes"
  },
  "exports": {
    "./default/css": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/aluminium/light.scss",
      "default": "./dist/aluminium/light.css"
    },
    "./default/fonts": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/fonts.scss",
      "default": "./dist/fonts.css"
    },
    "./fonts-base64": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/fonts-base64.scss",
      "default": "./dist/fonts-base64.css"
    },
    "./default/tokens": {
      "default": "./dist/aluminium/light.tokens.json"
    },
    "./blue-jeans/css": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/blue-jeans/light.scss",
      "default": "./dist/blue-jeans/light.css"
    },
    "./blue-jeans/tokens": {
      "default": "./dist/blue-jeans/light.tokens.json"
    },
    "./aluminium-dark/css": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/aluminium/dark.scss",
      "default": "./dist/aluminium/dark.css"
    },
    "./aluminium-dark/tokens": {
      "default": "./dist/aluminium/dark.tokens.json"
    },
    "./blue-jeans-dark/css": {
      "types": "./src/stylesheet.d.ts",
      "sass": "./src/blue-jeans/dark.scss",
      "default": "./dist/blue-jeans/dark.css"
    },
    "./blue-jeans-dark/tokens": {
      "default": "./dist/blue-jeans/dark.tokens.json"
    }
  },
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "scripts": {
    "build:ci": "npm run build:prod",
    "build:prod": "npm run generate:base64-fonts && sass src:dist --no-source-map --pkg-importer=node && npm run build:css && npm run bake && npm run generate:tokens",
    "bake": "node scripts/bake-themes.js",
    "build:css": "postcss dist/**/*.css --replace --use autoprefixer --parser postcss-scss --no-map",
    "build:watch": "sass --watch src:dist --no-source-map --pkg-importer=node",
    "clean": "rimraf dist",
    "generate:base64-fonts": "node scripts/generate-base64-fonts.js",
    "generate:tokens": "node scripts/generate-token-lists.js",
    "lint:css": "node scripts/check-retired-tokens.js && node scripts/repoint-tokens.js --tables > /dev/null && node scripts/generate-base64-fonts.js --check",
    "lint:scss": "stylelint '{assets,src}/**/*.scss'",
    "tokens:resolve": "sass src:dist --no-source-map --pkg-importer=node && node scripts/resolve-tokens.js"
  },
  "devDependencies": {
    "autoprefixer": "10.4.17",
    "postcss": "8.4.35",
    "postcss-cli": "11.0.1",
    "postcss-scss": "4.0.9",
    "sass": "1.103.1"
  },
  "browserslist": [
    "last 4 version",
    "maintained node versions"
  ]
}
